        "https://couriersplease.com.au",
        "https://crunchyroll.com",
        "https://discord.com",
        "https://ebay.com",
        "https://ebay.com.au",
        "https://element.io",
        "https://gentoo.org",
        "https://github.com",
        "https://gitlab.com",
        "https://godbolt.org",
        "https://gog.com",
        "https://icloud.com",
        "https://igashop.com.au",
        "https://ikea.com",
        "https://instantscripts.com.au",
        "https://jaycar.com.au",
        "https://jbhifi.com.au",
        "https://kmart.com.au",
        "https://lobste.rs",
        "https://macquarie.com.au",
        "https://music.apple.com",
        "https://nintendo.com",
        "https://nintendo.com.au",
        "https://officeworks.com.au",
        "https://onepass.com.au",
        "https://paypal.com",
        "https://pccasegear.com",
        "https://priceline.com.au",
        "https://scorptec.com.au",
        "https://selfwealth.com.au",
        "https://sr.ht",
        "https://target.com.au",
        "https://twitch.tv",
        "https://wikipedia.org",
        "https://youtube.com"
      ],
      "Behavior": "reject-tracker-and-partition-foreign",
      "Block": [
        "http://google.com",
        "https://google.com"
      ]
    },
    "DNSOverHTTPS": {
      "Enabled": true,
      "Locked": true,
      "ProviderURL": "https://dns.quad9.net/dns-query"
    },
    "DefaultDownloadDirectory": "${home}/stuff/downloads",
    "DisableAppUpdate": true,
    "DisableFeedbackCommands": true,
    "DisableFirefoxAccounts": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableTelemetry": true,
    "DisplayBookmarksToolbar": "newtab",
    "EnableTrackingProtection": {
      "Cryptomining": true,
      "Fingerprinting": true,
      "Locked": true,
      "Value": true
    },
    "EncryptedMediaExtensions": {
      "Enabled": true
    },
    "ExtensionSettings": {
      "amazon@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "bing@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "ddg@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "ebay@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "ecosia@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "google@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "uBlock0@raymondhill.net": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "installation_mode": "force_installed"
      },
      "wikipedia@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "{446900e4-71c2-419f-a6a7-df9c091e268b}": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/bitwarden-password-manager/latest.xpi",
        "installation_mode": "force_installed"
      }
    },
    "FirefoxHome": {
      "Highlights": false,
      "Locked": true,
      "Pocket": false,
      "Search": false,
      "Snippets": false,
      "SponsoredPocket": false,
      "SponsoredTopSites": false,
      "TopSites": false
    },
    "NetworkPrediction": false,
    "NoDefaultBookmarks": true,
    "OfferToSaveLogins": false,
    "OverrideFirstRunPage": "",
    "PasswordManagerEnabled": false,
    "Permissions": {
      "Autoplay": {
        "Default": "block-audio-video"
      },
      "Camera": {
        "BlockNewRequests": true
      },
      "Location": {
        "BlockNewRequests": true
      },
      "Microphone": {
        "Allow": [
          "https://discord.com"
        ],
        "BlockNewRequests": true
      },
      "Notifications": {
        "BlockNewRequests": true
      }
    },
    "Preferences": {
      "extensions.webextensions.restrictedDomains": {
        "Status": "locked",
        "Value": "appleid.apple.com,idmsa.apple.com,online.macquarie.com.au,secure.selfwealth.com.au,www.icloud.com,www-mail.icloud-sandbox.com"
      }
    },
    "SearchEngines": {
      "Add": [
        {
          "Alias": "!g",
          "Description": "Search Google",
          "IconURL": "https://www.google.com/favicon.ico",
          "Method": "GET",
          "Name": "Google (Custom)",
          "URLTemplate": "https://www.google.com/search?q={searchTerms}&gbv=1"
        },
        {
          "Alias": "!gb",
          "Description": "Search Gentoo Bugs",
          "IconURL": "https://www.gentoo.org/favicon.ico",
          "Method": "GET",
          "Name": "Gentoo Bugs",
          "URLTemplate": "https://bugs.gentoo.org/buglist.cgi?quicksearch={searchTerms}"
        },
        {
          "Alias": "!gp",
          "Description": "Search Gentoo Packages",
          "IconURL": "https://www.gentoo.org/favicon.ico",
          "Method": "GET",
          "Name": "Gentoo Packages",
          "URLTemplate": "https://packages.gentoo.org/packages/search?q={searchTerms}"
        },
        {
          "Alias": "!gw",
          "Description": "Search Gentoo Wiki",
          "IconURL": "https://www.gentoo.org/favicon.ico",
          "Method": "GET",
          "Name": "Gentoo Wiki",
          "URLTemplate": "https://wiki.gentoo.org/index.php?search={searchTerms}"
        },
        {
          "Alias": "!gh",
          "Description": "Search Github",
          "IconURL": "https://github.com/favicon.ico",
          "Method": "GET",
          "Name": "Github",
          "URLTemplate": "https://github.com/search?q={searchTerms}"
        },
        {
          "Alias": "!am",
          "Description": "Ask Moe!",
          "IconURL": "https://ask.moe/favicon.ico",
          "Method": "GET",
          "Name": "Ask Moe",
          "URLTemplate": "https://ask.moe/search?q={searchTerms}"
        }
      ],
      "Default": "Google (Custom)"
    },
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "Locked": true,
      "MoreFromMozilla": false,
      "SkipOnboarding": false,
      "UrlbarInterventions": false,
      "WhatsNew": false
    }
  }
}
