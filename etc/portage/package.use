# CPU FLAGS
*/* CPU_FLAGS_X86: aes avx avx2 bmi1 bmi2 f16c fma3 mmx mmxext pclmul popcnt rdrand sse sse2 sse3 sse4_1 sse4_2 ssse3

# VIDEO
*/* VIDEO_CARDS: -* amdgpu radeonsi
x11-libs/libdrm video_cards_radeon

# LANGUAGES
*/* L10N: en en_AU en-AU en_GB en-GB
*/* LINGUAS: en en_AU en-AU en_GB en-GB

# core
app-admin/doas persist
app-admin/sysklogd logrotate
app-misc/ddcutil user-permissions
sys-apps/iproute2 -iptables
sys-apps/util-linux -su
sys-fs/btrfs-progs -man
sys-fs/fuse suid
sys-process/procps -ncurses

# media
media-libs/babl introspection lcms
media-libs/gegl lcms introspection cairo
media-libs/libpulse -asyncns # libasyncns is unmaintained in gentoo
media-libs/libsdl2 gles2
media-libs/libvpx postproc
media-video/ffmpeg libass libdrm libxml2 mp3 openh264 opus srt theora vorbis vpx webp x264 x265
media-video/mpv jpeg

# x11 libs
x11-base/xwayland libei
x11-libs/gdk-pixbuf jpeg
x11-misc/j4-dmenu-desktop -dmenu

# enable/disable X
>=gui-libs/gtk-4 -X
dev-python/pycairo X
gui-apps/yambar -X
gui-libs/wlroots X
gui-wm/sway X
media-libs/libglvnd X
media-libs/libva X
media-libs/vulkan-loader X
sys-apps/dbus X
x11-libs/cairo X

# other
app-text/poppler cairo
app-text/xmlto text
dev-debug/gdb source-highlight
dev-lang/rust-bin clippy rustfmt rust-analyzer rust-src
media-fonts/noto -extra
media-libs/freetype harfbuzz
media-video/pipewire extra ffmpeg flatpak jack-sdk lv2 pipewire-alsa sound-server -man
www-client/firefox -telemetry -X

# 32bit ABI for steam
app-arch/bzip2  abi_x86_32
app-arch/xz-utils abi_x86_32
