# CPU FLAGS
*/* CPU_FLAGS_X86: aes avx avx2 bmi1 bmi2 f16c fma3 mmx mmxext pclmul popcnt rdrand sha sse sse2 sse3 sse4_1 sse4_2 sse4a ssse3 vpclmulqdq

# VIDEO
*/* VIDEO_CARDS: -* amdgpu radeonsi

# LANGUAGES
*/* L10N: en en_AU en-AU en_GB en-GB
*/* LINGUAS: en en_AU en-AU en_GB en-GB

# core
app-admin/doas persist
app-admin/sysklogd logrotate
sys-apps/iproute2 -iptables
sys-apps/util-linux -su
sys-fs/btrfs-progs -man
sys-fs/fuse suid
sys-kernel/installkernel grub
app-crypt/pinentry -gtk -qt6 -wayland

# media
media-libs/libpulse -asyncns # libasyncns is unmaintained in gentoo
media-video/ffmpeg mp3 openh264 opus srt theora vorbis vpx webp x265

# other
dev-debug/gdb source-highlight
dev-lang/rust-bin clippy rustfmt rust-analyzer rust-src
media-fonts/noto -extra
media-libs/freetype harfbuzz
media-video/pipewire extra ffmpeg flatpak jack-sdk lv2 pipewire-alsa sound-server -man
sys-apps/xdg-desktop-portal flatpak

# x11 libs
x11-misc/j4-dmenu-desktop -dmenu

# enable/disable X
gui-libs/wlroots X
gui-wm/sway X
media-libs/libepoxy X
media-libs/libglvnd X
media-libs/mesa X
sys-apps/flatpak X
