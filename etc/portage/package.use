# core
app-admin/doas persist
app-alternatives/sh -bash dash
sys-apps/iproute2 -iptables
sys-apps/util-linux -su
sys-fs/btrfs-progs -man
sys-fs/fuse suid
sys-process/procps -ncurses

# media
media-libs/libpulse -asyncns # libasyncns is unmaintained in gentoo
media-libs/libvpx postproc
media-video/ffmpeg libass libdrm libxml2 mp3 openh264 opus srt theora vorbis vpx webp x264 x265
media-video/mpv jpeg

# x11 libs
x11-base/xwayland libei
x11-libs/gdk-pixbuf jpeg
x11-misc/j4-dmenu-desktop -dmenu
x11-misc/xdg-user-dirs gtk

# enable/disable X
>=gui-libs/gtk-4 -X
gui-apps/yambar -X
gui-libs/wlroots X
gui-wm/sway X -swaybar
media-libs/libva X
media-libs/vulkan-loader X
sys-apps/dbus X
sys-apps/flatpak X
sys-apps/xdg-desktop-portal-gtk X
x11-libs/cairo X
x11-libs/libxkbcommon X
x11-terms/ghostty -X

# other
app-text/poppler cairo
app-text/xmlto text
dev-debug/gdb source-highlight
dev-lang/rust-bin clippy rustfmt rust-analyzer rust-src
media-fonts/noto cjk -extra
media-libs/freetype harfbuzz
media-video/pipewire extra ffmpeg flatpak jack-sdk lv2 pipewire-alsa sound-server -man
www-client/firefox -telemetry -X

# 32bit ABI for steam
app-arch/bzip2  abi_x86_32
