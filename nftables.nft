#!/usr/sbin/nft -f

# clear all prior state
flush ruleset

# basic firewall
table filter {
    chain input {
        type filter hook input priority 0; policy drop;
        ct state invalid drop comment "drop invalid"
        ct state { established, related } accept comment "accept extablished and related"
        iif != lo ip daddr 127.0.0.1/8 drop comment "drop connections to loopback not from loopback"
        iifname lo accept comment "accept localhost"
    }

    chain forward { type filter hook forward priority 0; policy drop; }
    chain output {
        type filter hook output priority 0; policy drop;
        tcp dport 22 accept comment "accept ssh outgoing"
        udp dport 53 accept comment "accept dns outgoing"
        tcp dport 443 accept comment "accept https outgoing"
        tcp dport 993 accept comment "accept imaps outgoing"
        tcp dport 587 accept comment "accept smtps outgoing"
    }
}
