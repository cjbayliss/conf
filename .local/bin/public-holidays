#!/bin/sh


# see: https://data.gov.au/data/dataset/australian-holidays-machine-readable-dataset
__PUBLIC_HOLIDAYS_DATASET="https://data.gov.au/data/dataset/b1bc6077-dadd-4f61-9f8c-002ab2cdff10/resource/9e920340-0744-4031-a497-98ab796633e8/download/australian_public_holidays_2024.csv"

curl -s "$__PUBLIC_HOLIDAYS_DATASET" |\
    column -s ',' --table-columns DATE,HOLIDAY,DESC,LINK,STATE,extra1,extra2,extra3 --json |\
    jq -r '.[].[] | select(.state == "vic\r") | [.date,.holiday] | @tsv'

unset $__PUBLIC_HOLIDAYS_DATASET
