#!/bin/sh

printf '{"version":1}\n['

__window_title() {
    swaymsg -t get_tree | jq -r '.. | objects | select(.focused) | {full_text: .name, color: "#bfbfbf", separator_block_width: 22}' | sed -e 's/}$/},/' -e 's/"[0-9]",$/"",/'
}

__mute() {
    mute="$(wpctl get-volume @DEFAULT_SINK@ | column -JN 'name,vol,mute' | jq -r '.table[].mute // ""')"
    printf "{'full_text':'%s','color':'#ff8059','separator_block_width':10,'separator':false}," "$mute"
}

__volume() {
    vol="$(wpctl get-volume @DEFAULT_SINK@ | column -JN 'name,vol,mute' | jq -r '.table[].vol' | sed 's/0\.//')"
    printf "{'full_text':'%s%%','separator_block_width':22}," "$vol"
}

__memory() {
    meminfo="$(grep -e MemTotal -e MemAvailable /proc/meminfo | column -JN 'name,value,unit')"
    total=$(printf "%s" "$meminfo" | jq -r '.table[] | select(.name == "MemTotal:").value')
    available=$(printf "%s" "$meminfo" | jq -r '.table[] | select(.name == "MemAvailable:").value')
    mem="$(((total-available)/1024))M/$((total/1024))M"
    percent="($(free | grep Mem | awk '{printf("%.00f\n", $3/$2 * 100.0)}')%)"
    printf "{'full_text':'%s %s','color':'#b0d6f5','separator_block_width':22}," "$mem" "$percent"
}

__ip() {
    printf "{'full_text':'%s','color':'#6ae4b9','separator_block_width':22}," "$(ip -j a | jq -r '[.[] | select(.operstate == "UP") | .addr_info[] | .local][0]')"
}

__load() {
    printf "{'full_text':'%s','separator_block_width':22}," "$(head -c4 /proc/loadavg)"
}

__date() {
    printf "{'full_text':'%s','color':'#f8dec0'}," "$(date '+%0e %^a %H:%M')"
}


high_refresh="$(__window_title)$(__mute)$(__volume)"
low_refresh="$(__memory)$(__ip)$(__load)$(__date)"

tick=0
while true; do
    high_refresh="$(__window_title)$(__mute)$(__volume)"
    if [ $tick -ge 5 ]; then # 1s
        tick=0
        low_refresh="$(__memory)$(__ip)$(__load)$(__date)"
    fi
    printf "["
    printf "%s" "$high_refresh"
    printf "%s" "$low_refresh"
    printf "],\n"
    tick=$((tick + 1))
    sleep 0.2 # 5hz
done
