#!/bin/sh

# FIXME: read this and make it sane, I wrote it late at night without
# careful thought

echo -e "{'version':1}\n["

__mute() {
    mute="$(pactl get-sink-mute @DEFAULT_SINK@ | sed -e 's/Mute: yes/AUDIO OFF/' -e 's/Mute: no//')"
    echo -n "{'full_text':'$mute','color':'#ff8059','separator_block_width':10,'separator':false},";
}

__volume() {
    vol="$(pactl get-sink-volume @DEFAULT_SINK@ | awk '/Volume:/ {print $5}')";
    printf "{'full_text':'%s','separator_block_width':22}," $vol;
}

__memory() {
    meminfo="$(grep -e MemTotal -e MemAvailable /proc/meminfo)";
    total="$(echo $meminfo | cut -d' ' -f2)";
    available="$(echo $meminfo | cut -d' ' -f5)";
    mem="$((($total-$available)/1024))M/$(($total/1024))M"
    percent="($(awk -vtotal=$(($total-available)) -vavailable=$available 'BEGIN{printf("%.00f\n",total/available*100)}')%)"
    printf "{'full_text':'%s %s','color':'#b0d6f5','separator_block_width':22}," $mem $percent
}


__ip() {
    printf "{'full_text':'%s','color':'#6ae4b9','separator_block_width':22}," "$(ip -j a | jq -r '[.[] | select(.operstate == "UP") | .addr_info[] | .local][0]')"
}

__load() {
    printf "{'full_text':'%s','separator_block_width':22}," "$(head -c4 /proc/loadavg)"
}

__date() {
    printf "{'full_text':'%s','color':'#f8dec0'}," "$(date '+%0e %^a %H:%M')";
}

tick=10;
while true; do
    printf "[";
    __mute;
    __volume;
    if [ $tick -ge 10 ]; then
        tick=0;
        status="$(__memory)$(__ip)$(__load)";
    fi
    echo -n $status; # NOTE: printf(1) strips spaces (??)
    __date;
    printf "],\n";
    tick=$(($tick + 1));
    sleep 1;
done
