#!/bin/sh

set -eu

brew="/opt/homebrew/bin/brew"
[ -x "$brew" ] || exit 0

out="${XDG_CONFIG_HOME:-$HOME/.config}/sh/env/brew"
tmp="$out.$$"
user="$(id -un)"

env -i HOME="$HOME" USER="$user" LOGNAME="$user" \
    XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}" PATH=/usr/bin:/bin \
    HOMEBREW_NO_ENV_HINTS=1 \
    "$brew" bundle env -g >"$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$out"
