#!/usr/bin/env python3

from os import environ as env
from pathlib import Path
import sys


def prompt_path(path: str, home: str) -> str:
    if home in path:
        path = path.replace(home, "~")

    path_array = Path(path).parts
    path = str()
    for dir in path_array:
        if dir == path_array[-1] or dir == "/":
            path = path + dir
            continue
        path = path + dir[0] + "/"

    return path


sys.stdout.write(prompt_path(env["PWD"], env["HOME"]))
