{
  "policies": {
    "CaptivePortal": false,
    "Cookies": {
      "Allow": [
        "https://amazon.com",
        "https://amazon.com.au",
        "https://anilist.co",
        "https://apple.com",
        "https://audible.com.au",
        "https://auspost.com.au",
        "https://bandcamp.com",
        "https://bitwarden.com",
        "https://bunnings.com.au",
        "https://centrelink.gov.au",
        "https://codeberg.org",
        "https://coles.com.au",
        "https://couriersplease.com.au",
        "https://crunchyroll.com",
        "https://discord.com",
        "https://ebay.com",
        "https://ebay.com.au",
        "https://fastmail.com",
        "https://gentoo.org",
        "https://github.com",
        "https://gitlab.com",
        "https://godbolt.org",
        "https://gog.com",
        "https://icloud.com",
        "https://igashop.com.au",
        "https://jaycar.com.au",
        "https://jbhifi.com.au",
        "https://kagi.com",
        "https://lobste.rs",
        "https://macquarie.com.au",
        "https://medicareaustralia.gov.au",
        "https://music.apple.com",
        "https://my.1password.eu",
        "https://my.gov.au",
        "https://myrecord.ehealth.gov.au",
        "https://officeworks.com.au",
        "https://onepass.com.au",
        "https://onlineservices.ato.gov.au",
        "https://paypal.com",
        "https://pccasegear.com",
        "https://scorptec.com.au",
        "https://selfwealth.com.au",
        "https://sr.ht",
        "https://target.com.au",
        "https://twitch.tv",
        "https://wikipedia.org",
        "https://youtube.com"
      ],
      "Behavior": "reject-tracker-and-partition-foreign"
    },
    "DNSOverHTTPS": {
      "Enabled": true,
      "Fallback": false,
      "Locked": true,
      "ProviderURL": "https://security.cloudflare-dns.com/dns-query"
    },
    "DefaultDownloadDirectory": "${home}/stuff/downloads",
    "DisableAppUpdate": true,
    "DisableFeedbackCommands": true,
    "DisableFirefoxAccounts": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableSecurityBypass": {
      "InvalidCertificate": true,
      "SafeBrowsing": true
    },
    "DisableSystemAddonUpdate": true,
    "DisableTelemetry": true,
    "DisplayBookmarksToolbar": "newtab",
    "DontCheckDefaultBrowser": true,
    "EnableTrackingProtection": {
      "Locked": true,
      "Category": "standard",
      "Value": false
    },
    "EncryptedMediaExtensions": {
      "Enabled": true
    },
    "ExtensionSettings": {
      "uBlock0@raymondhill.net": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "installation_mode": "normal_installed",
        "private_browsing": true
      },
      "{d634138d-c276-4fc8-924b-40a0ea21d284}": {
        "default_area": "navbar",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/1password-x-password-manager/latest.xpi",
        "installation_mode": "normal_installed"
      }
    },
    "FirefoxHome": {
      "Highlights": false,
      "Locked": true,
      "Pocket": false,
      "Search": false,
      "Snippets": false,
      "SponsoredPocket": false,
      "SponsoredTopSites": false,
      "TopSites": false
    },
    "GenerativeAI": {
      "Chatbot": false,
      "Enabled": false,
      "LinkPreviews": false,
      "Locked": true,
      "TabGroups": false
    },
    "HardwareAcceleration": true,
    "HttpsOnlyMode": "enabled",
    "NetworkPrediction": false,
    "NoDefaultBookmarks": true,
    "OfferToSaveLogins": false,
    "OverrideFirstRunPage": "",
    "PasswordManagerEnabled": false,
    "Permissions": {
      "Autoplay": {
        "Default": "block-audio-video"
      },
      "Camera": {
        "BlockNewRequests": true
      },
      "Location": {
        "BlockNewRequests": true
      },
      "Microphone": {
        "Allow": [
          "https://discord.com"
        ],
        "BlockNewRequests": true
      },
      "Notifications": {
        "BlockNewRequests": true
      }
    },
    "Preferences": {
      "browser.aboutConfig.showWarning": {
        "Value": false
      },
      "extensions.webextensions.restrictedDomains": {
        "Status": "locked",
        "Value": "appleid.apple.com,idmsa.apple.com,online.macquarie.com.au,secure.selfwealth.com.au,www.icloud.com,www-mail.icloud-sandbox.com,www.fastmail.com,app.fastmail.com,my.gov.au,auth.ato.gov.au,onlineservices.ato.gov.au,centrelink.gov.au,medicareaustralia.gov.au,myrecord.ehealth.gov.au"
      },
      "ui.key.menuAccessKeyFocuses": {
        "Value": false
      },
      "ui.systemUsesDarkTheme": {
        "Status": "default",
        "Type": "number",
        "Value": 1
      }
    },
    "SanitizeOnShutdown": {
      "Cache": true,
      "Cookies": true,
      "FormData": true,
      "Sessions": true
    },
    "SearchEngines": {
      "Add": [
        {
          "Alias": "!am",
          "Description": "Search Amazon",
          "IconURL": "https://www.amazon.com.au/favicon.ico",
          "Method": "GET",
          "Name": "Amazon (AU)",
          "URLTemplate": "https://www.amazon.com.au/s?k={searchTerms}"
        },
        {
          "Alias": "!gb",
          "Description": "Search Gentoo Bugs",
          "IconURL": "https://www.gentoo.org/favicon.ico",
          "Method": "GET",
          "Name": "Gentoo Bugs",
          "URLTemplate": "https://bugs.gentoo.org/buglist.cgi?quicksearch={searchTerms}"
        },
        {
          "Alias": "!gp",
          "Description": "Search Gentoo Packages",
          "IconURL": "https://www.gentoo.org/favicon.ico",
          "Method": "GET",
          "Name": "Gentoo Packages",
          "URLTemplate": "https://packages.gentoo.org/packages/search?q={searchTerms}"
        },
        {
          "Alias": "!gw",
          "Description": "Search Gentoo Wiki",
          "IconURL": "https://www.gentoo.org/favicon.ico",
          "Method": "GET",
          "Name": "Gentoo Wiki",
          "URLTemplate": "https://wiki.gentoo.org/index.php?search={searchTerms}"
        },
        {
          "Alias": "!gh",
          "Description": "Search Github",
          "IconURL": "https://github.com/favicon.ico",
          "Method": "GET",
          "Name": "Github",
          "URLTemplate": "https://github.com/search?q={searchTerms}"
        },
        {
          "Alias": "!w",
          "Description": "Search Wikipedia",
          "IconURL": "https://en.wikipedia.org/static/favicon/wikipedia.ico",
          "Method": "GET",
          "Name": "Wikipedia",
          "URLTemplate": "https://en.wikipedia.org/wiki/Special:Search?search={searchTerms}"
        },
        {
          "Alias": "define",
          "Description": "Search Wiktionary",
          "IconURL": "https://en.wiktionary.org/static/favicon/wiktionary/en.ico",
          "Method": "GET",
          "Name": "Wiktionary",
          "URLTemplate": "https://en.wiktionary.org/wiki/Special:Search?search={searchTerms}"
        },
        {
          "Alias": "!dp",
          "Description": "Search Debian Packages",
          "IconURL": "https://packages.debian.org/favicon.ico",
          "Method": "GET",
          "Name": "Debian Packages",
          "URLTemplate": "https://packages.debian.org/search?keywords={searchTerms}&searchon=names&section=all"
        },
        {
          "Alias": "!yt",
          "Description": "Search YouTube",
          "IconURL": "https://www.youtube.com/favicon.ico",
          "Method": "GET",
          "Name": "YouTube",
          "URLTemplate": "https://www.youtube.com/results?search_query={searchTerms}"
        },
        {
          "Alias": "!eb",
          "Description": "Search eBay",
          "IconURL": "https://www.ebay.com.au/favicon.ico",
          "Method": "GET",
          "Name": "eBay (AU)",
          "URLTemplate": "https://www.ebay.com.au/sch/i.html?kw={searchTerms}"
        },
        {
          "Alias": "!rw",
          "Description": "Search Old School RuneScape Wiki",
          "IconURL": "https://oldschool.runescape.wiki/favicon.ico",
          "Method": "GET",
          "Name": "Old School RuneScape Wiki",
          "URLTemplate": "https://oldschool.runescape.wiki/Special:Search?search={searchTerms}"
        },
        {
          "Alias": "!amo",
          "Description": "Search AMO",
          "IconURL": "https://addons.mozilla.org/favicon.ico",
          "Method": "GET",
          "Name": "AMO",
          "URLTemplate": "https://addons.mozilla.org/en-US/firefox/search/?q={searchTerms}"
        },
        {
          "Alias": "!m",
          "Description": "Search Marginalia",
          "IconURL": "https://marginalia-search.com/favicon.ico",
          "Method": "GET",
          "Name": "Marginalia",
          "URLTemplate": "https://marginalia-search.com/search?query={searchTerms}"
        },
        {
          "Alias": "!s",
          "Description": "Search Startpage",
          "IconURL": "https://www.startpage.com/favicon.ico",
          "Method": "POST",
          "Name": "Startpage",
          "PostData": "query={searchTerms}",
          "URLTemplate": "https://www.startpage.com/sp/search"
        }
      ],
      "Default": "Startpage",
      "Remove": [
        "Bing",
        "DuckDuckGo",
        "Google",
        "Twitter",
        "eBay",
        "Wikipedia (en)",
        "Perplexity"
      ]
    },
    "SearchSuggestEnabled": false,
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "Locked": true,
      "MoreFromMozilla": false,
      "SkipOnboarding": true,
      "UrlbarInterventions": false,
      "WhatsNew": false
    }
  }
}
