# load kak-tree-sitter first
eval %sh{ kak-tree-sitter -dks --init "$kak_session" }

colorscheme default

# colour overrides
set-face global Information default
set-face global MenuBackground default
set-face global MenuForeground default+br
set-face global PrimarySelection default+r

# basic kak-tree-sitter faces
set-face global ts_attribute attribute
set-face global ts_comment comment
set-face global ts_comment documentation
set-face global ts_constant value
set-face global ts_function function
set-face global ts_function_macro meta
set-face global ts_keyword keyword
set-face global ts_namespace module
set-face global ts_operator operator
set-face global ts_string string
set-face global ts_type type
set-face global ts_variable variable
set-face global ts_variable_builtin builtin

set-face global ts_diff_delta blue
set-face global ts_diff_delta_moved blue+i
set-face global ts_diff_minus red
set-face global ts_diff_plus green

# create directory before writing
hook -group user-bufwritepre global BufWritePre .* %{
    nop %sh{ mkdir -p "$(dirname "${kak_hook_param}")" }
}

# I used this all the time in vim/neovim/helix
alias global x write-quit

# keybinds
map global normal ' ' ''
map global normal \; ':enter-user-mode user<ret>' -docstring 'enter <user> user mode'
map global user \; ':comment-line<ret>' -docstring 'toggle comment'
map global user j ':tmux-repl-horizontal<ret>' -docstring 'open tmux pane'
map global user k ':lsp-hover<ret>' -docstring 'show info for current position'
map global user l ':enter-user-mode lsp<ret>' -docstring 'enter lsp user mode'

# clipboard
evaluate-commands %sh{
  if [ "$(uname)" = "Darwin" ]; then
    printf 'map global user p "!pbpaste<ret>" -docstring "paste from clipboard"\n'
    printf 'map global user y "<a-|>pbcopy<ret>" -docstring "yank to clipboard"\n'
  else
    printf 'map global user p "!wl-paste -n<ret>" -docstring "paste from clipboard"\n'
    printf 'map global user y "<a-|>wl-copy<ret>" -docstring "yank to clipboard"\n'
  fi
}

# wrap
map global user w '|fold -sw 72<ret>' -docstring 'wrap to 72'
map global user W '|fold -sw 80<ret>' -docstring 'wrap to 80'

map global goto n '<esc>:bn<ret>' -docstring 'next buffer'
map global goto p '<esc>:bp<ret>' -docstring 'previous buffer'

# extra highlighters
add-highlighter global/ number-lines -hlcursor -separator " " -min-digits 3
add-highlighter global/ regex '\b(FIXME|IMPORTANT|NOTE|TODO|WARNING|XXX)\b:' 0:default+rb
add-highlighter global/ regex '\h+$' 0:default,red
add-highlighter global/ show-matching

# default wrap
set-option global autowrap_column 72

# simpler assistant
set-option global ui_options terminal_assistant=none

# four is the lucky number
set-option global tabstop 4
set-option global indentwidth 4
add-highlighter global/yikes-thems-tabs show-whitespaces -spc ' ' -lf ' '

# spaces please
hook -group expandtabs global InsertChar \t %{ exec -draft h@ }
# except in these files
hook global BufCreate (.*\.(ebuild|c|h)$)|.*/metadata.xml|.*Makefile %{
    set-option buffer disabled_hooks expandtabs
}

# respect editorconfig
hook global BufCreate .* %{ try editorconfig-load }

# lsp
try %{
    eval %sh{kak-lsp --kakoune -s $kak_session}
    lsp-enable
    lsp-inlay-diagnostics-enable global # requires kakoune 2024 or newer
    lsp-inlay-hints-enable global

    set-face global InlayHint comment

    set-face global InfoBullet bullet
    set-face global InfoHeader header
    set-face global InfoLink link
    set-face global InfoLinkMono link
    set-face global InfoMono mono
}

# formatting
define-command -hidden format-on-save %{
    hook -group format-on-save window BufWritePre .* format
    hook -once -always WinSetOption filetype=.* %{
        unset-option window formatcmd
        remove-hooks window format-on-save
    }
}

hook global WinSetOption filetype=python %{
    set-option window formatcmd "ruff format -q -"
    format-on-save
}
hook global WinSetOption filetype=rust %{
    set-option window formatcmd rustfmt
    format-on-save
}
hook global WinSetOption filetype=markdown %{
    set-option window formatcmd "prettier --prose-wrap=always --parser=markdown --print-width=72"
    format-on-save
}

# filetypes
hook global BufCreate (/etc/portage/((m|p).*|sets/.*)|/var/lib/portage/.*|.*tmux\.conf) %{
    set-option buffer filetype sh
}

hook global BufCreate .*Containerfile.* %{
    set-option buffer filetype dockerfile
}

hook global BufCreate /etc/portage/repos.conf/.* %{
    set-option buffer filetype ini
}

hook global BufCreate .* %{ try modeline-parse }
