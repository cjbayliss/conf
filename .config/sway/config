# this essentially disabled the titlebar
font pango:monospace 0.1
titlebar_border_thickness 0
titlebar_padding 0

# borders and gaps
gaps inner 4
default_border pixel 2

# disable annoying stuff
focus_follows_mouse no

# colours
client.focused #b6a0ff #b6a0ff #000000 #b6a0ff
client.focused_inactive #444444 #444444 #000000 #444444
client.unfocused #444444 #444444 #000000 #444444

output "*" background #1a1a1a solid_color

input type:touchpad {
    tap enabled
    accel_profile "flat"
    natural_scroll enabled
    middle_emulation enabled
    pointer_accel 0.5
}

set $mod Mod4
set $left h
set $down j
set $up k
set $right l

# luanch stuff
bindsym $mod+Shift+Return exec foot
bindsym $mod+p exec j4-dmenu-desktop --no-generic --dmenu='wmenu -i -f "monospace 13" -N "#000000" -n "#ffffff" -S "#000000" -s "#b6a0ff"'

# kill focused window
bindsym $mod+Shift+c kill

floating_modifier $mod normal

bindsym $mod+r reload
bindsym $mod+Shift+q exec swaymsg exit

bindsym $mod+f fullscreen toggle

bindsym $mod+Tab focus left
bindsym $mod+Shift+Tab focus right

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# move window to workspace on start
for_window [app_id="mpv"] move window to workspace 9, focus
for_window [class="steam_app_238960" title="Path of Exile"] move window to workspace 4, focus; fullscreen enable
for_window [class="steam_app_2694490" title="Path of Exile 2"] move window to workspace 4, focus; fullscreen enable

bindsym $mod+w layout tabbed
bindsym $mod+t floating disable
bindsym $mod+Shift+t floating enable
bindsym $mod+space layout toggle tabbed split

bindsym $mod+minus exec pactl set-sink-volume @DEFAULT_SINK@ -2%
bindsym $mod+equal exec pactl set-sink-volume @DEFAULT_SINK@ +2%
bindsym $mod+0 exec pactl set-sink-mute @DEFAULT_SINK@ toggle

bindsym $mod+backslash exec playerctl play-pause
bindsym $mod+bracketleft exec playerctl previous
bindsym $mod+bracketright exec playerctl next

bar {
    font pango:JetBrains Mono Medium 12.5
    position top
    height 24
    separator_symbol "<"
    status_command cjbstatus

    colors {
        statusline #ffffff
        background #000000
        separator #a8a8a8
        focused_workspace #000000 #000000 #b6a0ff
        inactive_workspace #000000 #000000 #ffffff
    }
}

exec 'wlsunset -t 5000 -T 6300 -l -38 -L 145 &'
exec 'gentoo-pipewire-launcher restart &'
exec /usr/libexec/xdg-desktop-portal-gtk -r
exec /usr/libexec/xdg-desktop-portal-wlr -r
exec /usr/libexec/flatpak-portal -r
exec "sh -c 'sleep 5;exec /usr/libexec/xdg-desktop-portal -r'"

exec_always sh -c 'killall mako; mako &'
exec_always sh -c 'killall fcitx5; fcitx5 &'
