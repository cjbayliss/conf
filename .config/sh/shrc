#!/bin/sh

# alias stuff
unalias -a # ensure shitty distro aliases are removed first

alias grep="grep --color=auto --exclude-dir=.git"
alias ls="ls --color=auto -hF"

[ -f "$(command -v qlist)" ] && alias non-gentoo="qlist -IRv | grep -v ::gentoo | grep ::.*"
[ -f "$(command -v qlist)" ] && alias unmaintained-local="qlist -Iv \$(portageq --repo gentoo --orphaned)"

[ -f "$(command -v doas)" ] && alias poweroff="doas /usr/bin/poweroff"
[ -f "$(command -v doas)" ] && alias reboot="doas /usr/bin/reboot"

pst() {
    curl --data-binary "@${1:-/dev/stdin}" https://paste.rs && echo
}

[ -f "$(command -v gpg)" ] && [ -f "$(command -v tty)" ] && export GPG_TTY="$(tty)"

[ -n "$BASH_VERSION" ] && . "$XDG_CONFIG_HOME/bash/bashrc"
[ -n "$ZSH_VERSION" ] && . "$XDG_CONFIG_HOME/zsh/zshrc"

# clear on the console
__clear_console() {
    rm -rf ~/.cache/
    rm -rf ~/.w3m/
    rm -rf ~/.wget-hsts
    rm -rf ~/.python_history
    fgconsole 2>/dev/null && clear
}

trap __clear_console EXIT
