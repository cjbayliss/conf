#!/bin/sh

# alias stuff
alias grep="grep --color=auto --exclude-dir=.git"
alias ls="ls --color=auto -hF"

alias non-gentoo="qlist -IRv | grep -v ::gentoo | grep ::.*"
alias unmaintained-local="qlist -Iv \$(portageq --repo gentoo --orphaned)"

alias poweroff="doas /usr/bin/poweroff"
alias reboot="doas /usr/bin/reboot"

pst() {
    curl --data-binary "@${1:-/dev/stdin}" https://paste.rs && echo
}

watch() {
    while true; do
        reset; "$@"; sleep 5
    done
}

[ -f "$(command -v gpg)" ] && [ -f "$(command -v tty)" ] && export GPG_TTY="$(tty)"

[ -f "$HOME/.config/sh/envrc" ] && . "$HOME/.config/sh/envrc"

if [ -n "$BASH_VERSION" ]; then
    . "$XDG_CONFIG_HOME/bash/bashrc"
fi

# clear on the console
__clear_console() {
    rm -rf ~/.cache/
    rm -rf ~/.w3m/
    rm -rf ~/.wget-hsts
    rm -rf ~/.python_history
    fgconsole 2>/dev/null && clear
}

trap __clear_console EXIT
