#!/bin/sh

__brew_prefix=""
for __brew_dir in /opt/homebrew /home/linuxbrew/.linuxbrew /usr/local; do
    if [ -x "$__brew_dir/bin/brew" ]; then
        __brew_prefix="$__brew_dir"
        break
    fi
done

if [ -n "$__brew_prefix" ]; then
    export HOMEBREW_NO_ENV_HINTS=1
    [ -n "$BASH_VERSION" ] && eval "$("$__brew_prefix/bin/brew" shellenv bash)"
    [ -n "$ZSH_VERSION" ] && eval "$("$__brew_prefix/bin/brew" shellenv zsh)"
    [ -d "$__brew_prefix/opt/coreutils/libexec/gnubin" ] && PATH="$__brew_prefix/opt/coreutils/libexec/gnubin:$PATH"
    [ -d "$__brew_prefix/opt/gnu-sed/libexec/gnubin" ] && PATH="$__brew_prefix/opt/gnu-sed/libexec/gnubin:$PATH"
    [ -d "$__brew_prefix/opt/grep/libexec/gnubin" ] && PATH="$__brew_prefix/opt/grep/libexec/gnubin:$PATH"
    [ -d "$__brew_prefix/opt/man-db/libexec/bin" ] && PATH="$__brew_prefix/opt/man-db/libexec/bin:$PATH"
fi
unset __brew_prefix __brew_dir

brew() {
    command brew "$@"
    __brew_st=$?
    case "$1" in
        install|uninstall|reinstall|upgrade|bundle|cleanup|autoremove)
            command -v brew-env >/dev/null 2>&1 && ( brew-env >/dev/null 2>&1 & )
            ;;
    esac
    return $__brew_st
}
unset __brew_st
