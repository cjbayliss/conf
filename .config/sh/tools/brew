#!/bin/sh

if [ -x /opt/homebrew/bin/brew ]; then
    export HOMEBREW_NO_ENV_HINTS=1
    [ -n "$BASH_VERSION" ] && eval "$(/opt/homebrew/bin/brew shellenv bash)"
    [ -n "$ZSH_VERSION" ] && eval "$(/opt/homebrew/bin/brew shellenv zsh)"
    [ -d /opt/homebrew/opt/gnu-sed/libexec/gnubin ] && PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
    [ -d /opt/homebrew/opt/coreutils/libexec/gnubin ] && PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
fi

brew() {
    command brew "$@"
    __brew_st=$?
    case "$1" in
        install|uninstall|reinstall|upgrade|bundle|cleanup|autoremove)
            command -v brew-env >/dev/null 2>&1 && ( brew-env >/dev/null 2>&1 & )
            ;;
    esac
    return $__brew_st
}
unset __brew_st
