{
  "extends": ["default"],
  "meta": {
    "name": "maki",
    "version": "0.1.0",
    "description": "maki profile",
    "author": "cjb"
  },
  "groups": {
    "include": [
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      { "name": "user_caches_macos", "when": "macos" },
      { "name": "user_caches_linux", "when": "linux" },
      { "name": "linux_sysfs_read", "when": "linux" },
      "nix_runtime",
      "git_config",
      "unlink_protection"
    ]
  },
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      "$HOME/.config/maki",
      "$HOME/.local/logs/maki",
      "$HOME/.local/state/maki",
      "$HOME/.local/share/maki",
      "$NONO_CONFIG/profile-drafts"
    ],
    "read": [
      "$HOME/.nvm/",
      "$HOME/.agents/skills",
      "$NONO_PACKAGES",
      "$NONO_CONFIG/profiles",
      "$HOME/dev/repos/conf"
    ]
  },
  "network": {
    "block": false,
    "allow_domain": [],
    "credentials": [],
    "open_port": [],
    "listen_port": [],
    "custom_credentials": {}
  },
  "workdir": { "access": "readwrite" },
  "open_urls": {
    "allow_origins": [],
    "allow_localhost": true
  },
  "allow_launch_services": true,
  "rollback": {
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target",
      ".maki"
    ],
    "exclude_globs": ["*.tmp.[0-9]*.[0-9]*"]
  }
}
