[commit]
    verbose = true
    gpgSign = true

[diff]
    algorithm = "histogram"

[init]
    defaultBranch = "main"

[url "git@codeberg.org:"]
    pushInsteadOf = "https://codeberg.org/"

[url "git@github.com:"]
    pushInsteadOf = "https://github.com/"

[user]
    email = "cjbdev@icloud.com"
    name = "Christopher Bayliss"
    signingKey = 96EB7F84FD995CB60437F7AEE073B274B18A4A23

[push]
    autoSetupRemote = true
    gpgSign = "if-asked"

[pretty]
    compact = tformat:"%C(BrightYellow)%h%Creset %C(BrightCyan)%as%Creset %s"
    compact-author = tformat:"%C(BrightYellow)%h%Creset %C(BrightCyan)%as%Creset %C(Magenta)%aN %C(white)<%aE>%Creset %s"

[include]
    path = ~/.config/git/send-mail

[tag]
    gpgSign = true
