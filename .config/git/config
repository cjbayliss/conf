[commit]
    verbose = true

[diff]
    algorithm = "histogram"

[init]
    defaultBranch = "main"

[url "git@codeberg.org:"]
    pushInsteadOf = "https://codeberg.org/"

[url "git@github.com:"]
    pushInsteadOf = "https://github.com/"

[user]
    email = "cjbdev@fastmail.net"
    name = "Christopher Bayliss"

[push]
    autoSetupRemote = true

[pretty]
    compact = tformat:"%C(BrightYellow)%h%Creset %C(BrightCyan)%as%Creset %C(BrightRed)%d%Creset %s"
    compact-author = tformat:"%C(BrightYellow)%h%Creset %C(BrightCyan)%as%Creset %C(Magenta)%aN %C(white)<%aE>%Creset %C(BrightRed)%d%Creset %s"

[include]
    path = ~/.config/git/send-mail

# vim: set ft=conf
